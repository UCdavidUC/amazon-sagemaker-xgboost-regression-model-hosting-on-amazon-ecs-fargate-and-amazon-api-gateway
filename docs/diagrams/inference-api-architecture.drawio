        <!-- Legend -->
        <mxCell id="legend" value="Async flow: (1) API Lambda writes a QUEUED record to DynamoDB, (2) enqueues to the backend's SQS queue, returns 202 + request_id.&#10;A worker (Lambda event-source mapping OR ECS Fargate poller) runs inference and (3) updates the record to COMPLETED/FAILED.&#10;Clients poll GET /api/requests/{id}. All data encrypted at rest with the KMS CMK and in transit with TLS." style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="810" width="1100" height="80" as="geometry" />
        </mxCell>

