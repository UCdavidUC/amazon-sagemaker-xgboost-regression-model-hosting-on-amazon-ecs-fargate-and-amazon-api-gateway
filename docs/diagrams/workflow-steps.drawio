<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="draw.io" version="22.0.0" type="device">
  <diagram id="workflow-steps" name="Workshop Workflow">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Workshop Workflow: End-to-End ML Model Hosting on ECS Fargate" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Module 1: Prerequisites -->
        <mxCell id="step1" value="Module 1&#xa;&#xa;PREREQUISITES&#xa;&#xa;- Configure IAM roles&#xa;- Install Docker, CLI, SDK&#xa;- Setup ECR credential helper&#xa;- Configure S3 bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 2: Data Preparation -->
        <mxCell id="step2" value="Module 2&#xa;&#xa;DATA PREPARATION&#xa;&#xa;- Load California Housing CSV&#xa;- Train/Validate/Test split&#xa;- Standardize features&#xa;- Upload to S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 3: Training -->
        <mxCell id="step3" value="Module 3&#xa;&#xa;MODEL TRAINING&#xa;&#xa;- Configure XGBoost hyperparams&#xa;- Use SageMaker ModelTrainer&#xa;- Train on ml.m5.xlarge&#xa;- Output model.tar.gz to S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 4: Container -->
        <mxCell id="step4" value="Module 4&#xa;&#xa;CONTAINERIZATION&#xa;&#xa;- Extract model pickle from S3&#xa;- Create Dockerfile (AL2023)&#xa;- Build Docker image&#xa;- Push to ECR private registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 5: ECS Deployment -->
        <mxCell id="step5" value="Module 5&#xa;&#xa;ECS DEPLOYMENT&#xa;&#xa;- Create ECS cluster&#xa;- Register Fargate task definition&#xa;- Configure networking (VPC/SG)&#xa;- Run task with public IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 6: Testing -->
        <mxCell id="step6" value="Module 6&#xa;&#xa;TESTING&#xa;&#xa;- Wait for RUNNING state&#xa;- Get task public IP&#xa;- Configure Security Group&#xa;- Send HTTP POST with cURL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="1280" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 7: API Gateway -->
        <mxCell id="step7" value="Module 7 (Optional)&#xa;&#xa;API GATEWAY&#xa;&#xa;- Create HTTP/REST API&#xa;- Configure backend integration&#xa;- Setup ECS Service + ALB&#xa;- Enable auto scaling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="1520" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Module 8: Cleanup -->
        <mxCell id="step8" value="Module 8&#xa;&#xa;CLEANUP&#xa;&#xa;- Stop ECS tasks&#xa;- Deregister task definition&#xa;- Delete ECS cluster&#xa;- Delete ECR repository&#xa;- Delete S3 objects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;verticalAlign=middle;fontStyle=0;align=center;" vertex="1" parent="1">
          <mxGeometry x="1520" y="300" width="180" height="140" as="geometry" />
        </mxCell>

